leErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport React from \"react\";\r\nimport Image from \"next/image\";\r\nimport Link from \"next/link\";\r\nimport { useCart } from \"@/providers/CartContext\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Badge } from \"@/components/ui/badge\";\r\nimport { ShoppingCart, Barcode, Keyboard, X, Plus, Minus, Store, HelpCircle, Camera, ChevronRight, Info, ScanLine } from \"lucide-react\";\r\nimport { motion, AnimatePresence } from \"framer-motion\";\r\nimport { scanProduct } from \"@/lib/api\";\r\nimport { toast } from \"sonner\";\r\nimport { Html5Qrcode, Html5QrcodeSupportedFormats } from \"html5-qrcode\";\r\nimport {\r\n    Tooltip,\r\n    TooltipContent,\r\n    TooltipProvider,\r\n    TooltipTrigger,\r\n} from \"@/components/ui/tooltip\";\r\n\r\n// Declare BarcodeDetector on global window for TypeScript if needed\r\ndeclare global {\r\n    interface Window {\r\n        BarcodeDetector: any;\r\n    }\r\n}\r\n\r\nexport default function ScanPage() {\r\n    const { cart, refreshCart, removeFromCart, updateQuantity, cartTotal, itemCount } = useCart();\r\n    const [showManualInput, setShowManualInput] = React.useState(false);\r\n    const [manualBarcode, setManualBarcode] = React.useState(\"\");\r\n    const [hasCameraPermission, setHasCameraPermission] = React.useState<boolean | null>(null);\r\n    const [cameraStatus, setCameraStatus] = React.useState(\"Initializing...\");\r\n    const [scanStats, setScanStats] = React.useState({ count: 0, lastValue: \"\", lastError: \"\" });\r\n    const [showDebug, setShowDebug] = React.useState(false);\r\n\r\n    const inputRef = React.useRef<HTMLInputElement>(null);\r\n    const processingRef = React.useRef(false);\r\n    const scannerBuffer = React.useRef(\"\");\r\n    const lastKeyTime = React.useRef(0);\r\n\r\n    // Focus input when shown\r\n    React.useEffect(() => {\r\n        if (showManualInput && inputRef.current) {\r\n            inputRef.current.focus();\r\n        }\r\n    }, [showManualInput]);\r\n\r\n    // Handle Scan Success\r\n    const onScanSuccess = React.useCallback(async (rawText: string) => {\r\n        const decodedText = rawText.trim();\r\n        if (processingRef.current) return;\r\n\r\n        console.log(`Scan result: ${decodedText}`);\r\n        processingRef.current = true;\r\n\r\n        // Visual/Haptic Feedback\r\n        if (navigator.vibrate) navigator.vibrate([100]); // Short sharp vibration\r\n\r\n        try {\r\n            toast.loading(\"Adding item...\", { id: \"scan-toast\" }); // Loading state\r\n\r\n            const data = await scanProduct(decodedText);\r\n\r\n            if (data.success) {\r\n                if (navigator.vibrate) navigator.vibrate([100, 50, 100]); // Success vibration\r\n                toast.success(<span className=\"font-bold\">Added {data.product.name}</span>, {\r\n                    id: \"scan-toast\",\r\n                    icon: <div className=\"w-6 h-6 bg-green-500 rounded-full flex items-center justify-center text-white\"><Plus size={14} strokeWidth={4} /></div>\r\n                });\r\n                setScanStats(prev => ({ ...prev, count: prev.count + 1 }));\r\n                await refreshCart();\r\n            } else {\r\n                if (navigator.vibrate) navigator.vibrate([300]); // Error vibration\r\n                toast.error(data.error || \"Item not found\", { id: \"scan-toast\" });\r\n            }\r\n\r\n        } catch (error: any) {\r\n            if (navigator.vibrate) navigator.vibrate([300]); // Error vibration\r\n            if (error.response && error.response.status === 404) {\r\n                toast.error(\r\n                    <div className=\"flex flex-col gap-1\">\r\n                        <span className=\"font-bold\">Item not recognized</span>\r\n                        <span className=\"text-xs\">Try entering the code manually</span>\r\n                    </div>,\r\n                    {\r\n                        id: \"scan-toast\",\r\n                        action: {\r\n                            label: \"Manual Input\",\r\n                            onClick: () => setShowManualInput(true)\r\n                        }\r\n                    });\r\n            } else {\r\n                const errorMsg = error.response?.data?.details || error.response?.data?.error || \"Connection error\";\r\n                toast.error(errorMsg, { id: \"scan-toast\" });\r\n                setScanStats(prev => ({ ...prev, lastError: errorMsg }));\r\n            }\r\n        } finally {\r\n            setTimeout(() => {\r\n                processingRef.current = false;\r\n            }, 800); // Slightly longer delay to prevent double scans\r\n            setScanStats(prev => ({ ...prev, lastValue: decodedText }));\r\n        }\r\n    }, [refreshCart, setShowManualInput]);\r\n\r\n    // Manual Submit\r\n    const [isProcessingManual, setIsProcessingManual] = React.useState(false);\r\n    const handleManualSubmit = async (e: React.FormEvent) => {\r\n        e.preventDefault();\r\n        const code = manualBarcode.trim();\r\n        if (!code || isProcessingManual) return;\r\n\r\n        setIsProcessingManual(true);\r\n        try {\r\n            await onScanSuccess(code);\r\n            setManualBarcode(\"\");\r\n            setShowManualInput(false);\r\n        } catch (error) {\r\n            toast.error(\"Failed to process manual entry\");\r\n        } finally {\r\n            setIsProcessingManual(false);\r\n        }\r\n    };\r\n\r\n    // Hardware Scanner Listener\r\n    React.useEffect(() => {\r\n        const handleKeyDown = (e: KeyboardEvent) => {\r\n            if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;\r\n\r\n            const now = Date.now();\r\n            if (now - lastKeyTime.current > 100) scannerBuffer.current = \"\";\r\n            lastKeyTime.current = now;\r\n\r\n            if (e.key === 'Enter') {\r\n                if (scannerBuffer.current.length >= 8) {\r\n                    onScanSuccess(scannerBuffer.current);\r\n                    scannerBuffer.current = \"\";\r\n                }\r\n            } else if (e.key.length === 1) {\r\n                scannerBuffer.current += e.key;\r\n            }\r\n        };\r\n        window.addEventListener('keydown', handleKeyDown);\r\n        return () => window.removeEventListener('keydown', handleKeyDown);\r\n    }, [onScanSuccess]);\r\n\r\n    // Scanner Logic (Html5Qrcode)\r\n    const onScanSuccessRef = React.useRef(onScanSuccess);\r\n    React.useEffect(() => { onScanSuccessRef.current = onScanSuccess; }, [onScanSuccess]);\r\n\r\n    const html5QrCodeRef = React.useRef<Html5Qrcode | null>(null);\r\n    const isStartingRef = React.useRef(false);\r\n    const isScanningRef = React.useRef(false);\r\n\r\n    React.useEffect(() => {\r\n        let isMounted = true;\r\n        const safeStop = async () => {\r\n            if (!html5QrCodeRef.current) return;\r\n            if (isScanningRef.current) {\r\n                try { await html5QrCodeRef.current.stop(); } catch (e) { } finally { isScanningRef.current = false; }\r\n            }\r\n            try { html5QrCodeRef.current.clear(); } catch (e) { }\r\n        };\r\n\r\n        const initScanner = async () => {\r\n            if (isStartingRef.current || isScanningRef.current || showManualInput) {\r\n                if (showManualInput) await safeStop();\r\n                return;\r\n            }\r\n\r\n            isStartingRef.current = true;\r\n            setCameraStatus(\"Starting...\");\r\n\r\n            try {\r\n                await new Promise(r => setTimeout(r, 400));\r\n                if (!isMounted || showManualInput) return;\r\n\r\n                const element = document.getElementById(\"reader\");\r\n                if (!element) return;\r\n\r\n                if (!html5QrCodeRef.current) {\r\n                    html5QrCodeRef.current = new Html5Qrcode(\"reader\", {\r\n                        formatsToSupport: [Html5QrcodeSupportedFormats.EAN_13, Html5QrcodeSupportedFormats.EAN_8, Html5QrcodeSupportedFormats.UPC_A, Html5QrcodeSupportedFormats.UPC_E, Html5QrcodeSupportedFormats.CODE_128, Html5QrcodeSupportedFormats.QR_CODE],\r\n                        verbose: false\r\n                    });\r\n                }\r\n\r\n                const devices = await Html5Qrcode.getCameras();\r\n                const backCamera = devices && devices.length > 0 ? devices.find(d => d.label.toLowerCase().includes('back') || d.label.toLowerCase().includes('environment')) : null;\r\n\r\n                await html5QrCodeRef.current.start(\r\n                    backCamera ? { deviceId: backCamera.id } : { facingMode: \"environment\" },\r\n                    { fps: 20, aspectRatio: 1.0, qrbox: { width: 280, height: 280 } },\r\n                    (decodedText) => { if (isMounted && onScanSuccessRef.current) onScanSuccessRef.current(decodedText); },\r\n                    () => { }\r\n                );\r\n\r\n                if (isMounted) {\r\n                    isScanningRef.current = true;\r\n                    setHasCameraPermission(true);\r\n                    setCameraStatus(\"Active\");\r\n                } else await safeStop();\r\n\r\n            } catch (err: any) {\r\n                console.error(\"Scanner Error\", err);\r\n                if (isMounted) {\r\n                    setHasCameraPermission(false);\r\n                    setCameraStatus(\"Error\");\r\n                }\r\n            } finally {\r\n                isStartingRef.current = false;\r\n            }\r\n        };\r\n\r\n        initScanner();\r\n        return () => { isMounted = false; safeStop(); };\r\n    }, [showManualInput]);\r\n\r\n    return (\r\n        <div className=\"min-h-screen bg-white font-sans text-slate-900 selection:bg-blue-100 selection:text-blue-900\">\r\n            {/* Sticky Header */}\r\n            <header className=\"sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-100\">\r\n                <div className=\"max-w-7xl mx-auto px-4 h-16 flex items-center justify-between\">\r\n                    <Link href=\"/\" className=\"flex items-center gap-2.5 group\">\r\n                        <div className=\"w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center shadow-md shadow-blue-600/20 group-hover:scale-105 transition-transform\">\r\n                            <Store size={18} strokeWidth={2.5} />\r\n                        </div>\r\n                        <div className=\"flex flex-col\">\r\n                            <span className=\"text-sm font-bold leading-none tracking-tight\">SwiftCart AI</span>\r\n                            <span className=\"text-[10px] text-slate-500 font-medium\">Downtown Market</span>\r\n                        </div>\r\n                    </Link>\r\n\r\n                    <div className=\"flex items-center gap-2\">\r\n                        <TooltipProvider>\r\n                            <Tooltip delayDuration={0}>\r\n                                <TooltipTrigger asChild>\r\n                                    <button className=\"w-9 h-9 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition-colors\">\r\n                                        <Info size={18} />\r\n                                    </button>\r\n                                </TooltipTrigger>\r\n                                <TooltipContent side=\"bottom\" align=\"end\" className=\"max-w-[200px] p-4 text-xs\">\r\n                                    <p className=\"font-bold mb-1\">How to shop:</p>\r\n                                    <ol className=\"list-decimal list-inside space-y-1 text-slate-600\">\r\n                                        <li>Scan barcodes</li>\r\n                                        <li>Add to cart</li>\r\n                                        <li>Pay & go!</li>\r\n                                    </ol>\r\n                                </TooltipContent>\r\n                            </Tooltip>\r\n                        </TooltipProvider>\r\n\r\n                        <button\r\n                            onClick={() => setShowDebug(!showDebug)}\r\n                            className={`w-9 h-9 rounded-full flex items-center justify-center transition-colors ${showDebug ? 'bg-slate-900 text-white' : 'bg-slate-50 hover:bg-slate-100 text-slate-500'}`}\r\n                        >\r\n                            <ScanLine size={18} />\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </header>\r\n\r\n            <main className=\"max-w-7xl mx-auto p-4 lg:p-8 lg:grid lg:grid-cols-12 lg:gap-12 lg:items-start pb-32 lg:pb-8\">\r\n\r\n                {/* LEFT: Scanner Section */}\r\n                <div className=\"lg:col-span-5 lg:sticky lg:top-24 space-y-6\">\r\n                    {/* Scanner Card */}\r\n                    <div className=\"relative overflow-hidden rounded-[2.5rem] bg-slate-900 shadow-2xl shadow-blue-900/20 ring-4 ring-slate-50 aspect-[3/4] max-h-[500px] mx-auto lg:mx-0 w-full max-w-sm lg:max-w-full\">\r\n\r\n                        {!showManualInput ? (\r\n                            <>\r\n                                <div id=\"reader\" className=\"absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-overlay\"></div>\r\n                                {/* Clean Viewfinder UI */}\r\n                                <div className=\"absolute inset-0 z-10 flex flex-col items-center justify-center pointer-events-none\">\r\n                                    {/* Active Scanning Frame */}\r\n                                    <div className=\"relative w-64 h-64\">\r\n                                        {/* Corner Markers */}\r\n                                        <div className=\"absolute top-0 left-0 w-8 h-8 border-l-4 border-t-4 border-blue-500 rounded-tl-xl\"></div>\r\n                                        <div className=\"absolute top-0 right-0 w-8 h-8 border-r-4 border-t-4 border-blue-500 rounded-tr-xl\"></div>\r\n                                        <div className=\"absolute bottom-0 left-0 w-8 h-8 border-l-4 border-b-4 border-blue-500 rounded-bl-xl\"></div>\r\n                                        <div className=\"absolute bottom-0 right-0 w-8 h-8 border-r-4 border-b-4 border-blue-500 rounded-br-xl\"></div>\r\n\r\n                                        {/* Scanning Laser Animation */}\r\n                                        <div className=\"absolute inset-x-0 h-[2px] bg-red-500/80 shadow-[0_0_15px_rgba(239,68,68,0.8)] animate-[scan_2s_ease-in-out_infinite]\"></div>\r\n\r\n                                        {/* Center Target */}\r\n                                        <div className=\"absolute inset-0 flex items-center justify-center opacity-50\">\r\n                                            <div className=\"w-12 h-1 h-px bg-white/20\"></div>\r\n                                            <div className=\"h-12 w-1 w-px bg-white/20 absolute\"></div>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                                    {/* Guidance Text */}\r\n                                    <div className=\"absolute bottom-12 bg-black/60 backdrop-blur-md px-6 py-2.5 rounded-full border border-white/10 shadow-xl flex items-center gap-3\">\r\n                                        <div className=\"w-2.5 h-2.5 rounded-full bg-green-500 animate-pulse shadow-[0_0_10px_rgba(34,197,94,0.6)]\"></div>\r\n                                        <span className=\"text-white font-bold text-sm tracking-wide\">Align Barcode</span>\r\n                                    </div>\r\n                                </div>\r\n                            </>\r\n                        ) : (\r\n                            <div className=\"absolute inset-0 bg-white flex flex-col items-center justify-center p-8 text-center z-20\">\r\n                                <h3 className=\"text-xl font-bold text-slate-900 mb-6\">Enter Barcode</h3>\r\n                                <form onSubmit={handleManualSubmit} className=\"w-full space-y-4\">\r\n                                    <input\r\n                                        ref={inputRef}\r\n                                        type=\"text\"\r\n                                        inputMode=\"numeric\"\r\n                                        pattern=\"[0-9]*\"\r\n                                        placeholder=\"000000000000\"\r\n                                        className=\"w-full px-4 py-5 rounded-2xl bg-slate-50 border-2 border-slate-100 text-center text-2xl font-mono tracking-widest text-slate-900 focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-500/10 transition-all font-bold placeholder:text-slate-300\"\r\n                                        value={manualBarcode}\r\n                                        onChange={(e) => setManualBarcode(e.target.value)}\r\n                                    />\r\n                                    <div className=\"flex gap-3\">\r\n                                        <Button type=\"button\" variant=\"outline\" size=\"lg\" className=\"flex-1 rounded-xl font-bold border-slate-200 text-slate-600 hover:bg-slate-50\" onClick={() => setShowManualInput(false)}>Cancel</Button>\r\n                                        <Button type=\"submit\" size=\"lg\" className=\"flex-1 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold shadow-lg shadow-blue-600/20\" disabled={isProcessingManual}>\r\n                                            {isProcessingManual ? \"Adding...\" : \"Add\"}\r\n                                        </Button>\r\n                                    </div>\r\n                                </form>\r\n                            </div>\r\n                        )}\r\n\r\n                        {/* Controls Bottom Right */}\r\n                        <div className=\"absolute bottom-6 right-6 z-20\">\r\n                            <Button\r\n                                size=\"icon\"\r\n                                className={`w-12 h-12 rounded-full shadow-xl border-4 border-slate-900/50 ${showManualInput ? 'bg-slate-800 text-white hover:bg-slate-700' : 'bg-white text-slate-900 hover:bg-slate-100'}`}\r\n                                onClick={() => setShowManualInput(!showManualInput)}\r\n                            >\r\n                                {showManualInput ? <Camera size={20} /> : <Keyboard size={20} />}\r\n                            </Button>\r\n                        </div>\r\n                    </div>\r\n\r\n                    {/* Debug Info (Collapsible) */}\r\n                    <AnimatePresence>\r\n                        {showDebug && (\r\n                            <motion.div initial={{ opacity: 0, height: 0 }} animate={{ opacity: 1, height: 'auto' }} exit={{ opacity: 0, height: 0 }} className=\"bg-slate-900 rounded-xl p-4 text-xs font-mono text-slate-400 overflow-hidden\">\r\n                                <div className=\"grid grid-cols-2 gap-2\">\r\n                                    <div className=\"flex justify-between\"><span>Status:</span> <span className=\"text-white\">{cameraStatus}</span></div>\r\n                                    <div className=\"flex justify-between\"><span>Scans:</span> <span className=\"text-blue-400\">{scanStats.count}</span></div>\r\n                                    <div className=\"col-span-2 truncate text-slate-500\">Last: {scanStats.lastValue || \"None\"}</div>\r\n                                    {scanStats.lastError && <div className=\"col-span-2 text-red-400 truncate\">Err: {scanStats.lastError}</div>}\r\n                                </div>\r\n                            </motion.div>\r\n                        )}\r\n                    </AnimatePresence>\r\n                </div>\r\n\r\n                {/* RIGHT: Cart & Checkout Section */}\r\n                <div className=\"lg:col-span-7 flex flex-col h-full mt-8 lg:mt-0\">\r\n                    <div className=\"flex items-center justify-between mb-6 px-1\">\r\n                        <h2 className=\"text-2xl font-black text-slate-900 tracking-tight\">Your Cart</h2>\r\n                        <Badge variant=\"secondary\" className=\"px-3 py-1 text-sm font-bold bg-slate-100 text-slate-600 rounded-full\">{itemCount} items</Badge>\r\n                    </div>\r\n\r\n                    {/* Scrollable Cart List */}\r\n                    <div className=\"flex-1 relative min-h-[300px] lg:min-h-[500px]\">\r\n                        {(!cart || !cart.items || cart.items.length === 0) ? (\r\n                            <div className=\"absolute inset-0 flex flex-col items-center justify-center text-center p-8 border-2 border-dashed border-slate-100 rounded-3xl\">\r\n                                <div className=\"w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mb-4 text-slate-300\">\r\n                                    <ShoppingCart size={32} />\r\n                                </div>\r\n                                <h3 className=\"text-lg font-bold text-slate-900\">Your cart is empty</h3>\r\n                                <p className=\"text-slate-500 max-w-[200px] mt-1\">Scan a barcode to start building your cart.</p>\r\n                            </div>\r\n                        ) : (\r\n                            <div className=\"space-y-4 pb-4\">\r\n                                <AnimatePresence mode=\"popLayout\">\r\n                                    {cart?.items?.map((item: any) => (\r\n                                        <motion.div\r\n                                            layout\r\n                                            initial={{ opacity: 0, scale: 0.95, y: 10 }}\r\n                                            animate={{ opacity: 1, scale: 1, y: 0 }}\r\n                                            exit={{ opacity: 0, scale: 0.95 }}\r\n                                            key={item.id}\r\n                                            className=\"bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex gap-4 group hover:border-blue-100 transition-colors\"\r\n                                        >\r\n                                            {/* Product Image */}\r\n                                            <div className=\"w-20 h-20 bg-slate-50 rounded-xl p-2 shrink-0 flex items-center justify-center\">\r\n                                                {/* eslint-disable-next-line @next/next/no-img-element */}\r\n                                                <img\r\n                                                    src={item.product?.imageUrl || item.product?.image || '/placeholder.png'}\r\n                                                    alt={item.product?.name}\r\n                                                    className=\"w-full h-full object-contain mix-blend-multiply\"\r\n                                                    onError={(e) => { e.currentTarget.src = '/placeholder.png'; }}\r\n                                                />\r\n                                            </div>\r\n\r\n                                            {/* Details */}\r\n                                            <div className=\"flex-1 flex flex-col justify-between\">\r\n                                                <div className=\"flex justify-between items-start\">\r\n                                                    <h3 className=\"font-bold text-slate-900 line-clamp-2 leading-tight pr-4\">{item.product?.name || \"Unknown Item\"}</h3>\r\n                                                    <button onClick={() => removeFromCart(item.id)} className=\"text-slate-300 hover:text-red-500 transition-colors p-1 -mr-2 -mt-2\">\r\n                                                        <X size={18} />\r\n                                                    </button>\r\n                                                </div>\r\n\r\n                                                <div className=\"flex items-end justify-between mt-2\">\r\n                                                    {/* Quantity Controls */}\r\n                                                    <div className=\"flex items-center bg-slate-50 rounded-lg p-1 border border-slate-100\">\r\n                                                        <button\r\n                                                            onClick={() => updateQuantity(item.id, -1)}\r\n                                                            className=\"w-7 h-7 flex items-center justify-center rounded-md hover:bg-white hover:shadow-sm text-slate-500 transition-all disabled:opacity-50\"\r\n                                                            disabled={item.quantity <= 1}\r\n                                                        >\r\n                                                            <Minus size={14} strokeWidth={3} />\r\n                                                        </button>\r\n                                                        <span className=\"w-8 text-center font-bold text-sm text-slate-900\">{item.quantity}</span>\r\n                                                        <button\r\n                                                            onClick={() => updateQuantity(item.id, 1)}\r\n                                                            className=\"w-7 h-7 flex items-center justify-center rounded-md hover:bg-white hover:shadow-sm text-slate-900 transition-all\"\r\n                                                        >\r\n                                                            <Plus size={14} strokeWidth={3} />\r\n                                                        </button>\r\n                                                    </div>\r\n\r\n                                                    {/* Price */}\r\n                                                    <div className=\"text-right\">\r\n                                                        <div className=\"text-xs text-slate-400 font-medium line-through decoration-slate-300 mr-1 inline-block\">\r\n                                                            {item.product?.mrp > item.price ? `Γé╣${item.product.mrp}` : ''}\r\n                                                        </div>\r\n                                                        <div className=\"text-lg font-black text-slate-900 inline-block\">\r\n                                                            Γé╣{(Number(item.price) * item.quantity).toFixed(2)}\r\n                                                        </div>\r\n                                                    </div>\r\n                                                </div>\r\n                                            </div>\r\n                                        </motion.div>\r\n                                    ))}\r\n                                </AnimatePresence>\r\n                            </div>\r\n                        )}\r\n                    </div>\r\n                </div>\r\n            </main>\r\n\r\n            {/* Sticky Checkout Footer */}\r\n            <div className=\"fixed bottom-0 inset-x-0 bg-white border-t border-slate-100 p-4 pb-6 lg:pb-4 shadow-[0_-10px_40px_rgba(0,0,0,0.05)] z-50\">\r\n                <div className=\"max-w-7xl mx-auto flex flex-col lg:flex-row gap-4 items-center\">\r\n\r\n                    {/* Price Breakdown (Desktop: Left, Mobile: Top) */}\r\n                    <div className=\"w-full lg:w-auto lg:flex-1 flex justify-between lg:justify-start lg:gap-8 items-baseline px-2 lg:px-0\">\r\n                        <div className=\"flex items-baseline gap-2\">\