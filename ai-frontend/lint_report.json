ssName=\"bg-slate-50 border-b border-slate-100 p-4 flex justify-between items-center\">\r\n                                <h3 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2\">\r\n                                    <Store size={14} className=\"text-slate-400\" /> Receipt\r\n                                </h3>\r\n                                <div className=\"text-xs font-mono text-slate-400\">#{Math.floor(Math.random() * 100000)}</div>\r\n                            </div>\r\n                            <div className=\"divide-y divide-slate-100\">\r\n                                {lastOrder.items.map((item: any, idx: number) => (\r\n                                    <div key={idx} className=\"flex justify-between p-4 text-sm bg-white hover:bg-slate-50 transition-colors\">\r\n                                        <div className=\"flex gap-3\">\r\n                                            <span className=\"font-bold text-slate-900\">{item.product?.name || item.name || 'Item'}</span>\r\n                                            <span className=\"text-slate-400 text-xs py-0.5 px-1.5 bg-slate-100 rounded-md font-bold\">x{item.quantity}</span>\r\n                                        </div>\r\n                                        <span className=\"font-bold text-slate-900\">Γé╣{(item.price * item.quantity).toFixed(2)}</span>\r\n                                    </div>\r\n                                ))}\r\n                            </div>\r\n                            <div className=\"p-4 bg-slate-50 border-t border-slate-100 flex justify-between items-center text-lg\">\r\n                                <span className=\"text-slate-500 font-medium\">Total Paid</span>\r\n                                <span className=\"font-black text-slate-900\">Γé╣{lastOrder.total.toFixed(2)}</span>\r\n                            </div>\r\n                        </div>\r\n                    </motion.div>\r\n                )}\r\n\r\n                <motion.div\r\n                    initial={{ y: 20, opacity: 0 }}\r\n                    animate={{ y: 0, opacity: 1 }}\r\n                    transition={{ delay: 0.3 }}\r\n                    className=\"w-full mt-6\"\r\n                >\r\n                    <div className=\"bg-slate-900 p-5 rounded-2xl shadow-xl flex flex-col items-center gap-3 w-full relative overflow-hidden group\">\r\n                        <div className=\"absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500\"></div>\r\n                        <div className=\"absolute -top-10 -right-10 w-32 h-32 bg-blue-500/20 rounded-full blur-3xl\"></div>\r\n\r\n                        <p className=\"text-white/60 text-[10px] font-bold uppercase tracking-[0.2em] relative z-10\">Digital Exit Pass</p>\r\n                        <div className=\"bg-white p-3 rounded-xl shadow-inner relative z-10\">\r\n                            <div className=\"w-32 h-32 bg-[url('https://lh3.googleusercontent.com/aida-public/AB6AXuCaL4k0z7LJZ_6fAb5GARk3UuBHWuf6Jkhg1GB1lrwycMKxgyHQgOJKOC7wagHjsF08MMS9fC5hqJeX90nF5dUPrkseLnDnPCgyqVTkatsJvJnikJ2jUw8rgvR5be1grCsaWvWsHEmznlVdOeq5yibVs1ZwzI2ulDWszeod_qjxL5SrqUPS7hjd8DZE3_02am76uI3pAT0RXu9dvLjPu7JQ7uNh08Wj7MkFk3Dwtf8yU_J8-_WAzhTwNHOk0HtCg2AWgN-slcZpBV01')] bg-contain bg-center bg-no-repeat mix-blend-multiply opacity-90\"></div>\r\n                        </div>\r\n                        <p className=\"text-blue-200 text-[10px] font-medium animate-pulse relative z-10\">Show this at the exit gate</p>\r\n                    </div>\r\n                </motion.div>\r\n            </main>\r\n\r\n            <div className=\"p-6 pb-10 space-y-4 bg-white border-t border-slate-100 rounded-t-[2rem] shadow-[0_-10px_40px_rgba(0,0,0,0.05)] z-20\">\r\n                <Link href=\"/customer/scan\">\r\n                    <Button className=\"w-full h-14 bg-blue-600 hover:bg-blue-700 text-white font-bold text-base shadow-lg shadow-blue-600/20 rounded-xl\">\r\n                        Start New Order\r\n                    </Button>\r\n                </Link>\r\n                <div className=\"flex gap-3\">\r\n                    <Button variant=\"outline\" className=\"flex-1 gap-2 h-12 rounded-xl border-slate-200 hover:bg-slate-50 font-bold text-slate-600\" onClick={handleDownloadInvoice} disabled={!lastOrder}>\r\n                        <Download size={16} />\r\n                        Invoice\r\n                    </Button>\r\n                    <Dialog open={isEmailOpen} onOpenChange={setIsEmailOpen}>\r\n                        <DialogTrigger asChild>\r\n                            <Button variant=\"outline\" className=\"flex-1 gap-2 h-12 rounded-xl border-slate-200 hover:bg-slate-50 font-bold text-slate-600\">\r\n                                <Mail size={16} />\r\n                                Email\r\n                            </Button>\r\n                        </DialogTrigger>\r\n                        <DialogContent className=\"sm:max-w-[425px] rounded-2xl\">\r\n                            <DialogHeader>\r\n                                <DialogTitle>Email Receipt</DialogTitle>\r\n                                <DialogDescription>\r\n                                    Enter your email address to receive a digital copy of your bill.\r\n                                </DialogDescription>\r\n                            </DialogHeader>\r\n                            <div className=\"grid gap-4 py-4\">\r\n                                <div className=\"grid grid-cols-4 items-center gap-4\">\r\n                                    <Label htmlFor=\"email\" className=\"text-right\">\r\n                                        Email\r\n                                    </Label>\r\n                                    <Input\r\n                                        id=\"email\"\r\n                                        type=\"email\"\r\n                                        placeholder=\"you@example.com\"\r\n                                        className=\"col-span-3 rounded-xl\"\r\n                                        value={email}\r\n                                        onChange={(e) => setEmail(e.target.value)}\r\n                                    />\r\n                                </div>\r\n                            </div>\r\n                            <DialogFooter>\r\n                                <Button type=\"submit\" onClick={handleSendEmail} disabled={isSending} className=\"rounded-xl w-full\">\r\n                                    {isSending ? \"Sending...\" : \"Send Receipt\"}\r\n                                </Button>\r\n                            </DialogFooter>\r\n                        </DialogContent>\r\n                    </Dialog>\r\n                </div>\r\n                <div className=\"flex items-center justify-center gap-1.5 text-[10px] text-slate-400 uppercase tracking-widest font-bold pt-2\">\r\n                    <Lock size={10} />\r\n                    <p>Secured by SwiftCart AI</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sadguru\\OneDrive\\Desktop\\SwiftCart AI\\ai-frontend\\app\\demo\\page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Play' is defined but never used.","line":8,"column":10,"nodeType":null,"messageId":"unusedVar","endLine":8,"endColumn":14},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'activeTab' is assigned a value but never used.","line":13,"column":12,"nodeType":null,"messageId":"unusedVar","endLine":13,"endColumn":21}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\r\n\r\nimport React, { useState } from \"react\";\r\nimport { useDemo } from \"@/providers/DemoProvider\";\r\nimport { Button } from \"@/components/ui/button\";\r\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\r\nimport { toast } from \"sonner\";\r\nimport { Play, RotateCcw, ShoppingCart, CreditCard, Box, Zap, Activity } from \"lucide-react\";\r\nimport { motion } from \"framer-motion\";\r\n\r\nexport default function DemoControlPage() {\r\n    const { addToCart, inventory, processPayment, resetDemo } = useDemo();\r\n    const [activeTab, setActiveTab] = useState(\"customer\");\r\n\r\n    const handleSimulateAdd = () => {\r\n        const randomProduct = inventory[Math.floor(Math.random() * inventory.length)];\r\n        addToCart(randomProduct);\r\n        toast.success(`added ${randomProduct.name}`, {\r\n            description: \"Simulating shopper action...\",\r\n            icon: <ShoppingCart className=\"w-4 h-4 text-blue-600\" />,\r\n        });\r\n    };\r\n\r\n    const handleReset = () => {\r\n        resetDemo();\r\n        toast.info(\"Demo Reset\", { description: \"Session cleared.\" });\r\n    };\r\n\r\n    return (\r\n        <div className=\"min-h-screen bg-slate-50 py-20 px-4 flex flex-col items-center\">\r\n\r\n            {/* Header */}\r\n            <div className=\"max-w-3xl w-full text-center mb-12\">\r\n                <div className=\"inline-flex items-center gap-2 px-3 py-1 mb-6 rounded-full bg-white border border-blue-100 shadow-sm shadow-blue-500/10\">\r\n                    <span className=\"relative flex h-2 w-2\">\r\n                        <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75\"></span>\r\n                        <span className=\"relative inline-flex rounded-full h-2 w-2 bg-blue-500\"></span>\r\n                    </span>\r\n                    <span className=\"text-[10px] font-bold uppercase tracking-wider text-blue-900\">Live Simulator</span>\r\n                </div>\r\n                <h1 className=\"text-4xl md:text-5xl font-black text-slate-900 tracking-tight mb-4\">\r\n                    Control the <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600\">Experience.</span>\r\n                </h1>\r\n                <p className=\"text-lg text-slate-500 font-medium max-w-xl mx-auto\">\r\n                    Trigger real-time events to see how SwiftCart handles shoppers, inventory, and payments instantly.\r\n                </p>\r\n            </div>\r\n\r\n            {/* Main Card */}\r\n            <motion.div\r\n                initial={{ opacity: 0, y: 20 }}\r\n                animate={{ opacity: 1, y: 0 }}\r\n                transition={{ duration: 0.5 }}\r\n                className=\"max-w-3xl w-full bg-white rounded-[2.5rem] shadow-2xl shadow-slate-200/50 border border-slate-100 overflow-hidden\"\r\n            >\r\n                <div className=\"p-8 md:p-12\">\r\n                    <div className=\"flex items-center justify-between mb-8\">\r\n                        <div>\r\n                            <h2 className=\"text-2xl font-bold text-slate-900 flex items-center gap-2\">\r\n                                <Activity className=\"text-blue-600\" /> Simulation Studio\r\n                            </h2>\r\n                            <p className=\"text-slate-500 font-medium\">Select an actor to trigger actions.</p>\r\n                        </div>\r\n                        <Button\r\n                            variant=\"outline\"\r\n                            size=\"sm\"\r\n                            onClick={handleReset}\r\n                            className=\"rounded-xl border-slate-200 hover:bg-slate-50 text-slate-600 font-bold gap-2\"\r\n                        >\r\n                            <RotateCcw size={14} /> Reset Session\r\n                        </Button>\r\n                    </div>\r\n\r\n                    <Tabs defaultValue=\"customer\" className=\"w-full\" onValueChange={setActiveTab}>\r\n                        <TabsList className=\"grid w-full grid-cols-2 mb-10 h-14 bg-slate-50 p-1.5 rounded-2xl\">\r\n                            <TabsTrigger\r\n                                value=\"customer\"\r\n                                className=\"rounded-xl text-sm font-bold data-[state=active]:bg-white data-[state=active]:text-blue-700 data-[state=active]:shadow-sm h-full\"\r\n                            >\r\n                                Customer Actions\r\n                            </TabsTrigger>\r\n                            <TabsTrigger\r\n                                value=\"retailer\"\r\n                                className=\"rounded-xl text-sm font-bold data-[state=active]:bg-white data-[state=active]:text-indigo-700 data-[state=active]:shadow-sm h-full\"\r\n                            >\r\n                                Retailer Events\r\n                            </TabsTrigger>\r\n                        </TabsList>\r\n\r\n                        <TabsContent value=\"customer\" className=\"space-y-6\">\r\n                            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\r\n                                <button\r\n                                    onClick={handleSimulateAdd}\r\n                                    className=\"group relative flex flex-col items-center justify-center p-8 rounded-3xl bg-blue-50/50 border-2 border-dashed border-blue-200 hover:bg-blue-50 hover:border-blue-400 hover:scale-[1.02] transition-all duration-200\"\r\n                                >\r\n                                    <div className=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center mb-4 text-blue-600 group-hover:scale-110 transition-transform\">\r\n                                        <ShoppingCart size={32} />\r\n                                    </div>\r\n                                    <h3 className=\"text-lg font-bold text-slate-900 mb-1\">Add Item</h3>\r\n                                    <p className=\"text-sm text-slate-500 font-medium\">Random Product</p>\r\n                                </button>\r\n\r\n                                <button\r\n                                    onClick={processPayment}\r\n                                    className=\"group relative flex flex-col items-center justify-center p-8 rounded-3xl bg-green-50/50 border-2 border-dashed border-green-200 hover:bg-green-50 hover:border-green-400 hover:scale-[1.02] transition-all duration-200\"\r\n                                >\r\n                                    <div className=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center mb-4 text-green-600 group-hover:scale-110 transition-transform\">\r\n                                        <CreditCard size={32} />\r\n                                    </div>\r\n                                    <h3 className=\"text-lg font-bold text-slate-900 mb-1\">Checkout</h3>\r\n                                    <p className=\"text-sm text-slate-500 font-medium\">Process Payment</p>\r\n                                </button>\r\n                            </div>\r\n                        </TabsContent>\r\n\r\n                        <TabsContent value=\"retailer\" className=\"space-y-6\">\r\n                            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\r\n                                <button\r\n                                    className=\"group relative flex flex-col items-center justify-center p-8 rounded-3xl bg-indigo-50/50 border-2 border-dashed border-indigo-200 hover:bg-indigo-50 hover:border-indigo-400 hover:scale-[1.02] transition-all duration-200\"\r\n                                >\r\n                                    <div className=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center mb-4 text-indigo-600 group-hover:scale-110 transition-transform\">\r\n                                        <Box size={32} />\r\n                                    </div>\r\n                                    <h3 className=\"text-lg font-bold text-slate-900 mb-1\">Restock</h3>\r\n                                    <p className=\"text-sm text-slate-500 font-medium\">Add Inventory (+20)</p>\r\n                                </button>\r\n\r\n                                <button\r\n                                    className=\"group relative flex flex-col items-center justify-center p-8 rounded-3xl bg-amber-50/50 border-2 border-dashed border-amber-200 hover:bg-amber-50 hover:border-amber-400 hover:scale-[1.02] transition-all duration-200\"\r\n                                >\r\n                                    <div className=\"w-16 h-16 rounded-2xl bg-white shadow-sm flex items-center justify-center mb-4 text-amber-600 group-hover:scale-110 transition-transform\">\r\n                                        <Zap size={32} />\r\n                                    </div>\r\n                                    <h3 className=\"text-lg font-bold text-slate-900 mb-1\">Price Surge</h3>\r\n                                    <p className=\"text-sm text-slate-500 font-medium\">Trigger Dynamic Pricing</p>\r\n                                </button>\r\n                            </div>\r\n                        </TabsContent>\r\n                    </Tabs>\r\n                </div>\r\n\r\n                {/* Footer of Card */}\r\n                <div className=\"bg-slate-50 border-t border-slate-100 p-6 text-center\">\r\n                    <p className=\"text-xs font-bold text-slate-400 uppercase tracking-widest\">\r\n                        Interactions sync across all active windows\r\n                    </p>\r\n                </div>\r\n            </motion.div>\r\n        </div>\r\n    );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Sadguru\\OneDrive\\Desktop\\SwiftCart AI\\ai-frontend\\app\\layout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableEr